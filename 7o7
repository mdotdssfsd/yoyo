        BadgeCorner.Parent = PremiumBadge

        local BadgeText = Instance.new("TextLabel")
        BadgeText.Size = UDim2.new(1, 0, 1, 0)
        BadgeText.BackgroundTransparency = 1
        BadgeText.Text = "PREMIUM ONLY"
        BadgeText.TextColor3 = THEME.AccentRed
        BadgeText.Font = Enum.Font.GothamBold
        BadgeText.TextSize = 8
        BadgeText.Parent = PremiumBadge
    else
        local ToggleBtn = Instance.new("TextButton")
        ToggleBtn.Size = UDim2.new(0, 32, 0, 16)
        ToggleBtn.Position = UDim2.new(1, -32, 0.5, -8)
        ToggleBtn.BackgroundColor3 = isEnabled and THEME.AccentGreen or THEME.DarkTrack
        ToggleBtn.Text = ""
        ToggleBtn.Parent = Item

        local ToggleCorner = Instance.new("UICorner")
        ToggleCorner.CornerRadius = UDim.new(1, 0)
        ToggleCorner.Parent = ToggleBtn

        local ToggleKnob = Instance.new("Frame")
        ToggleKnob.Size = UDim2.new(0, 12, 0, 12)
        ToggleKnob.Position = isEnabled and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
        ToggleKnob.BackgroundColor3 = THEME.TextPrimary
        ToggleKnob.BorderSizePixel = 0
        ToggleKnob.Parent = ToggleBtn

        local KnobCorner = Instance.new("UICorner")
        KnobCorner.CornerRadius = UDim.new(1, 0)
        KnobCorner.Parent = ToggleKnob

        local active = isEnabled
        ToggleBtn.MouseButton1Click:Connect(function()
            active = not active
            local targetBg = active and THEME.AccentGreen or THEME.DarkTrack
            local targetPos = active and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
            
            TweenService:Create(ToggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = targetBg}):Play()
            TweenService:Create(ToggleKnob, TweenInfo.new(0.15), {Position = targetPos}):Play()
            if callback then callback(active) end
        end)
    end
end

-- SLIDER BUILDER
local function createSlider(tabName, title, minVal, maxVal, defaultVal, isPremium, order, callback)
    local parent = tabFrames[tabName]
    local Item = Instance.new("Frame")
    Item.Size = UDim2.new(1, 0, 0, 38)
    Item.BackgroundTransparency = 1
    Item.LayoutOrder = order
    Item.Parent = parent

    local isLocked = isPremium and not isWhitelistedUser

    local MainText = Instance.new("TextLabel")
    MainText.Size = UDim2.new(0.5, 0, 0, 16)
    MainText.BackgroundTransparency = 1
    MainText.Text = title
    MainText.TextColor3 = isLocked and THEME.TextSecondary or THEME.TextPrimary
    MainText.Font = Enum.Font.GothamMedium
    MainText.TextSize = 11
    MainText.TextXAlignment = Enum.TextXAlignment.Left
    MainText.Parent = Item

    local ValueText = Instance.new("TextLabel")
    ValueText.Size = UDim2.new(0.5, 0, 0, 16)
    ValueText.Position = UDim2.new(0.5, 0, 0, 0)
    ValueText.BackgroundTransparency = 1
    ValueText.Text = tostring(defaultVal)
    ValueText.TextColor3 = THEME.TextSecondary
    ValueText.Font = Enum.Font.Gotham
    ValueText.TextSize = 10
    ValueText.TextXAlignment = Enum.TextXAlignment.Right
    ValueText.Parent = Item

    if isLocked then
        ValueText.Visible = false
        local PremiumBadge = Instance.new("Frame")
        PremiumBadge.Size = UDim2.new(0, 85, 0, 20)
        PremiumBadge.Position = UDim2.new(1, -85, 0, 0)
        PremiumBadge.BackgroundColor3 = THEME.CardBg
        PremiumBadge.BorderSizePixel = 0
        PremiumBadge.Parent = Item

        local BadgeCorner = Instance.new("UICorner")
        BadgeCorner.CornerRadius = UDim.new(0, 4)
        BadgeCorner.Parent = PremiumBadge

        local BadgeText = Instance.new("TextLabel")
        BadgeText.Size = UDim2.new(1, 0, 1, 0)
        BadgeText.BackgroundTransparency = 1
        BadgeText.Text = "PREMIUM ONLY"
        BadgeText.TextColor3 = THEME.AccentRed
        BadgeText.Font = Enum.Font.GothamBold
        BadgeText.TextSize = 8
        BadgeText.Parent = PremiumBadge
    end

    local Track = Instance.new("TextButton")
    Track.Size = UDim2.new(1, 0, 0, 4)
    Track.Position = UDim2.new(0, 0, 0, 24)
    Track.BackgroundColor3 = THEME.DarkTrack
    Track.BorderSizePixel = 0
    Track.Text = ""
    Track.Parent = Item

    local startPercent = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(startPercent, 0, 1, 0)
    Fill.BackgroundColor3 = isLocked and THEME.TextSecondary or THEME.AccentGreen
    Fill.BorderSizePixel = 0
    Fill.Parent = Track

    local DiamondKnob = Instance.new("Frame")
    DiamondKnob.Size = UDim2.new(0, 8, 0, 8)
    DiamondKnob.Position = UDim2.new(1, -4, 0.5, -4)
    DiamondKnob.BackgroundColor3 = THEME.TextPrimary
    DiamondKnob.Rotation = 45
    DiamondKnob.BorderSizePixel = 0
    DiamondKnob.Parent = Fill

    if not isLocked then
        local sliding = false
        local function updateSlider(input)
            local mousePos = input.Position.X
            local trackPos = Track.AbsolutePosition.X
            local trackWidth = Track.AbsoluteSize.X
            local percent = math.clamp((mousePos - trackPos) / trackWidth, 0, 1)
            local val = math.floor((minVal + (percent * (maxVal - minVal))) * 10) / 10
            
            Fill.Size = UDim2.new(percent, 0, 1, 0)
            ValueText.Text = tostring(val)
            if callback then callback(val) end
        end

        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                updateSlider(input)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
    end
end

