local CONFIG_FOLDER = "5SmooveHub/configs"
local ConfigEntries = {}

local function ensureConfigFolder()
    if type(makefolder) ~= "function" then
        return
    end
    pcall(makefolder, "5SmooveHub")
    pcall(makefolder, CONFIG_FOLDER)
end

local function configFile(name)
    local safe = tostring(name):gsub("[^%w%-%_ ]", ""):sub(1, 40)
    if safe == "" then safe = "Default" end
    return CONFIG_FOLDER .. "/" .. safe .. ".json"
end

local function encodeFeatureState()
    local data = {}
    for key, value in pairs(FeatureState) do
        if typeof(value) == "Color3" then
            data[key] = {
                __type = "Color3",
                r = value.R,
                g = value.G,
                b = value.B
            }
        elseif typeof(value) == "EnumItem" then
            data[key] = {
                __type = "EnumItem",
                enum = tostring(value.EnumType),
                name = value.Name
            }
        elseif type(value) == "boolean" or type(value) == "number" or type(value) == "string" then
            data[key] = value
        end
    end
    return HttpService:JSONEncode(data)
end

local function decodeFeatureState(raw)
    local ok, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not ok or type(data) ~= "table" then
        return nil
    end

    local decoded = {}
    for key, value in pairs(data) do
        if type(value) == "table" and value.__type == "Color3" then
            decoded[key] = Color3.new(
                tonumber(value.r) or 1,
                tonumber(value.g) or 1,
                tonumber(value.b) or 1
            )
        elseif type(value) == "table" and value.__type == "EnumItem" then
            local enumType = tostring(value.enum or "")
            local enumName = tostring(value.name or "")
            local enumTable = Enum[enumType:gsub("^Enum%.", "")]
            if enumTable and enumTable[enumName] then
                decoded[key] = enumTable[enumName]
            end
        else
            decoded[key] = value
        end
    end
    return decoded
end

local function applyConfigData(data)
    if type(data) ~= "table" then return false end

    for key, value in pairs(data) do
        if FeatureState[key] ~= nil then
            FeatureState[key] = value
        end
    end

    -- Refresh the parts that have an immediate runtime effect.
    if type(refreshTargetBoxes) == "function" then
        refreshTargetBoxes()
    end
    if type(updateAnimationSpeeds) == "function" then
        updateAnimationSpeeds()
    end
    if type(setCameraSensitivity) == "function" then
        setCameraSensitivity()
    end
    return true
end

