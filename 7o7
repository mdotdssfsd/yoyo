---------------------------------------------------------
-- AUTO STOMP / MOBILE BUTTON ADAPTER
-- Detects a downed humanoid and activates the game's own
-- mobile Stomp button when that button is available.
-- It does not guess or fire arbitrary remotes.
---------------------------------------------------------

local AutoStompState = {
    target = nil,
    downed = false,
    distance = 0,
    button = nil,
    lastPress = 0,
    cooldown = 0.35,
}

local function isDownedCharacter(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    -- Support common downed/ragdoll markers used by Roblox games.
    local downedNames = {
        "Downed", "Down", "Knocked", "KnockedDown",
        "Ragdoll", "IsDowned", "DownedState"
    }

    for _, name in ipairs(downedNames) do
        local marker = character:FindFirstChild(name)
        if marker then
            if marker:IsA("BoolValue") and marker.Value then return true end
            if marker:IsA("IntValue") or marker:IsA("NumberValue") then
                if marker.Value > 0 then return true end
            end
            if marker:IsA("StringValue") and marker.Value ~= "" then return true end
        end
    end

    -- Humanoid states commonly used while a character is physically down.
    local state = humanoid:GetState()
    return state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.Ragdoll
end

local function findMobileStompButton()
    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return nil end

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("GuiButton") and obj.Visible then
            local text = string.lower(tostring(obj.Text or ""))
            local name = string.lower(obj.Name or "")

            if string.find(text, "stomp", 1, true)
                or string.find(name, "stomp", 1, true) then
                return obj
            end
        end
    end

    return nil
end

local function pressMobileStomp()
    local now = os.clock()
    if now - AutoStompState.lastPress < AutoStompState.cooldown then
        return false
    end

    local button = AutoStompState.button
    if not button or not button.Parent or not button.Visible then
        button = findMobileStompButton()
        AutoStompState.button = button
    end

    if not button then
        return false
    end

    local ok = pcall(function()
        button:Activate()
    end)

    if ok then
        AutoStompState.lastPress = now
        return true
    end

    return false
end

local function updateAutoStomp()
    AutoStompState.target = nil
    AutoStompState.downed = false
    AutoStompState.distance = 0

    if not FeatureState.AutoStomp then
        return
    end

    local myRoot = getRoot(LocalPlayer)
    if not myRoot then return end

    local closest, closestDistance
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local root = getRoot(player)
            local character = getCharacter(player)

            if root and character and isDownedCharacter(character) then
                local distance = (root.Position - myRoot.Position).Magnitude
                if distance <= 15 and (not closestDistance or distance < closestDistance) then
                    closest = player
                    closestDistance = distance
                end
            end
        end
    end

    AutoStompState.target = closest
    AutoStompState.downed = closest ~= nil
    AutoStompState.distance = closestDistance or 0

    if closest then
        pressMobileStomp()
    end
end

local function getNearestTarget()
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then
        return nil
    end

    local best, bestDistance
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local root = getRoot(player)
            local distance = root and (root.Position - myRoot.Position).Magnitude
            if distance and distance <= FeatureState.KARange then
                if not bestDistance or distance < bestDistance then
                    best, bestDistance = player, distance
                end
            end
        end
    end
    return best
end

local function getLowestHealthTarget()
    local myRoot = getRoot(LocalPlayer)
    if not myRoot then
        return nil
    end

    local best, bestHealth, bestDistance
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local root, humanoid = getRoot(player), getHumanoid(player)
            local distance = root and (root.Position - myRoot.Position).Magnitude
            if distance and distance <= FeatureState.KARange then
                if not bestHealth or humanoid.Health < bestHealth then
                    best = player
                    bestHealth = humanoid.Health
                    bestDistance = distance
                elseif humanoid.Health == bestHealth and distance < bestDistance then
                    best = player
                    bestDistance = distance
                end
            end
        end
    end
    return best
end

local currentTarget = nil
local worldUpdateClock = 0

local function updateKillAuraTarget()
    if not FeatureState.KillAura then
        currentTarget = nil
        return
    end

    if FeatureState.KALowestHealth then
        currentTarget = getLowestHealthTarget()
    else
        currentTarget = getNearestTarget()
    end
end

local function updateGlide()
    if not FeatureState.WeaveGlide then
        return
    end

    local root = getRoot(LocalPlayer)
    local humanoid = getHumanoid(LocalPlayer)
    if not root or not humanoid or humanoid.Health <= 0 then
        return
    end

    local move = humanoid.MoveDirection
    if move.Magnitude > 0 then
        local strength = math.clamp(FeatureState.WeaveGlideStrength, 1, 10)
        root.AssemblyLinearVelocity = Vector3.new(
            move.X * 16 * strength,
            root.AssemblyLinearVelocity.Y,
            move.Z * 16 * strength
        )
    end
end

local function refreshStatus()
    if not StatusLabel or not StatusLabel.Parent then
        return
    end
    if FeatureState.KillAura and currentTarget then
        StatusLabel.Text = "● TARGET"
    elseif FeatureState.WeaveGlide then
        StatusLabel.Text = "● GLIDE"
    else
        StatusLabel.Text = "● READY"
    end
end

