-- Server Presence Signal System (Live API integration template via Webhook / Request)
local function refreshLivePresence()
    for _, child in ipairs(ListScrollView:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local currentPlayers = Players:GetPlayers()
    ServerValue.Text = tostring(#currentPlayers)

    -- Populate player list for current server
    for _, plr in ipairs(currentPlayers) do
        local plan = "FREE"
        local lowerName = plr.Name:lower()
        if lowerName == "socertempr" or lowerName == "kaidkln" then
            plan = "OWNER"
        end
        createUserEntry(plr, plan)
    end

    -- Global online count via JSON endpoint fallback
    task.spawn(function()
        local success, result = pcall(function()
            if request or http_request or (syn and syn.request) then
                local req = request or http_request or syn.request
                local response = req({
                    Url = "https://httpbin.org/get", -- Replace with custom backend database server endpoint if available
                    Method = "GET"
                })
                return HttpService:JSONDecode(response.Body)
            end
        end)

        -- httpbin confirms HTTP access only; it does not contain a Roblox
        -- global player count, so never display a fabricated number.
        GlobalValue.Text = tostring(#currentPlayers)
    end)
end

