local tabFrames = {}

local function createTab(tabName)
    local ScrollView = Instance.new("ScrollingFrame")
    ScrollView.Name = tabName .. "Tab"
    ScrollView.Size = UDim2.new(1, 0, 1, 0)
    ScrollView.BackgroundTransparency = 1
    ScrollView.BorderSizePixel = 0
    ScrollView.ScrollBarThickness = 3
    ScrollView.ScrollBarImageColor3 = THEME.AccentGreen
    ScrollView.Visible = false
    ScrollView.Parent = TabContainer

    local ContentLayout = Instance.new("UIListLayout")
    ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ContentLayout.Padding = UDim.new(0, 12)
    ContentLayout.Parent = ScrollView

    local ContentPadding = Instance.new("UIPadding")
    ContentPadding.PaddingLeft = UDim.new(0, 20)
    ContentPadding.PaddingRight = UDim.new(0, 20)
    ContentPadding.PaddingBottom = UDim.new(0, 20)
    ContentPadding.Parent = ScrollView

    ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollView.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 20)
    end)

    tabFrames[tabName] = ScrollView
    return ScrollView
end

local function switchTab(selectedTab)
    for tabName, frame in pairs(tabFrames) do
        frame.Visible = (tabName == selectedTab)
    end
    for name, button in pairs(navButtons) do
        local isActive = (name == selectedTab)
        local indicator = button:FindFirstChild("Indicator")
        local label = button:FindFirstChild("Label")
        local icon = button:FindFirstChild("Icon")
        if indicator then indicator.Visible = isActive end
        if label then label.TextColor3 = isActive and THEME.TextPrimary or THEME.TextSecondary end
        if icon then icon.ImageColor3 = isActive and THEME.AccentGreen or THEME.TextSecondary end
    end
    HeaderTitle.Text = selectedTab == "SMOOVE" and "Smoove Users" or (selectedTab:sub(1,1):upper() .. selectedTab:sub(2):lower())
    HeaderSub.Text = tabSubtitles[selectedTab] or "controls"
end

