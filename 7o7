        if lowerName == "socertempr"
            or lowerName == "kaidkln" then

            plan = "OWNER"
        end

        createUserEntry(plr, plan)
    end

    task.spawn(function()
        pcall(function()
            if request
                or http_request
                or (syn and syn.request) then

                local req =
                    request
                    or http_request
                    or syn.request

                req({
                    Url = "https://httpbin.org/get",
                    Method = "GET"
                })
            end
        end)

        GlobalValue.Text = tostring(#currentPlayers)
    end)
end

