    end
end)



---------------------------------------------------------
-- WORLD VISUALS
-- Client-side visual effects only. Safe no-op when a
-- particular object/effect is unavailable.
---------------------------------------------------------
local WorldState = {
    Enabled = false,
    UpgradeScale = 5,
    Saturation = 0,
    Contrast = 0,
    Brightness = 0,
    NoTrees = false,
    NoGrass = false,
    SkyPreset = "Midnight",
}

local worldOriginals = {}
local worldEffects = {}
local worldLastScan = 0

local function getWorldScale()
    return math.clamp(tonumber(WorldState.UpgradeScale) or 5, 1, 10) / 5
end

local function ensureWorldEffects()
    local lighting = game:GetService("Lighting")

    local cc = worldEffects.ColorCorrection
    if not cc or not cc.Parent then
        cc = lighting:FindFirstChild("5SmooveWorldColorCorrection")
        if not cc then
            cc = Instance.new("ColorCorrectionEffect")
            cc.Name = "5SmooveWorldColorCorrection"
            cc.Parent = lighting
        end
        worldEffects.ColorCorrection = cc
    end

    local bloom = worldEffects.Bloom
    if not bloom or not bloom.Parent then
        bloom = lighting:FindFirstChild("5SmooveWorldBloom")
        if not bloom then
            bloom = Instance.new("BloomEffect")
            bloom.Name = "5SmooveWorldBloom"
            bloom.Parent = lighting
        end
        worldEffects.Bloom = bloom
    end

    return cc, bloom
end

local function applyWorldVisuals()
    local lighting = game:GetService("Lighting")

    if not WorldState.Enabled then
        local cc = worldEffects.ColorCorrection
        if cc then cc.Enabled = false end
        local bloom = worldEffects.Bloom
        if bloom then bloom.Enabled = false end

        for obj, original in pairs(worldOriginals) do
            if obj and obj.Parent then
                pcall(function()
                    obj.LocalTransparencyModifier = original
                end)
            end
        end
        return
    end

    local cc, bloom = ensureWorldEffects()
    local s = getWorldScale()

    cc.Enabled = true
    cc.Saturation = math.clamp((tonumber(WorldState.Saturation) or 0) * s, -1, 1)
    cc.Contrast = math.clamp((tonumber(WorldState.Contrast) or 0) * s, -1, 1)
    cc.Brightness = math.clamp((tonumber(WorldState.Brightness) or 0) * s, -1, 1)

    bloom.Enabled = true
    bloom.Intensity = math.clamp(0.05 * s, 0, 1)
    bloom.Size = 12
    bloom.Threshold = 1

    local sky = lighting:FindFirstChildOfClass("Sky")
    if sky then
        local preset = tostring(WorldState.SkyPreset)
        local tint = Color3.fromRGB(255, 255, 255)
        if preset == "Midnight" then
            tint = Color3.fromRGB(255, 255, 255)
        elseif preset == "Purple" then
            tint = Color3.fromRGB(255, 255, 255)
        elseif preset == "Blue" then
            tint = Color3.fromRGB(255, 255, 255)
        elseif preset == "Warm" then
            tint = Color3.fromRGB(255, 255, 255)
        end
        pcall(function() sky.SkyboxTintColor = tint end)
    end

    local now = os.clock()
    if now - worldLastScan < 0.5 then return end
    worldLastScan = now

    for _, obj in ipairs(workspace:GetDescendants()) do
        local name = string.lower(obj.Name or "")
        local isTree = WorldState.NoTrees and (
            string.find(name, "tree", 1, true) or
            string.find(name, "bush", 1, true) or
            string.find(name, "plant", 1, true)
        )
        local isGrass = WorldState.NoGrass and (
            string.find(name, "grass", 1, true) or
            string.find(name, "foliage", 1, true)
        )

        if (isTree or isGrass) and obj:IsA("BasePart") then
            if worldOriginals[obj] == nil then
                worldOriginals[obj] = obj.LocalTransparencyModifier
            end
            obj.LocalTransparencyModifier = 1
        end
    end
end

