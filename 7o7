local originalFOV = nil
local function updateCameraVisuals()
    local camera = workspace.CurrentCamera
    if not camera then return end
    if originalFOV == nil then originalFOV = camera.FieldOfView end
    if FeatureState.StretchedRes then
        -- Roblox LocalScripts cannot change the physical monitor aspect ratio.
        -- A mild FOV compensation gives a consistent stretched-look approximation.
        local scale = math.clamp(tonumber(FeatureState.ResolutionScale) or 0.8, 0.1, 1)
        camera.FieldOfView = math.clamp(originalFOV + ((1 - scale) * 18), 1, 120)
    else
        camera.FieldOfView = originalFOV
    end
end

