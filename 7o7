local function findLocationPart(name)
    if not name or name:gsub("%s", "") == "" then return nil end
    local wanted = name:lower()
    local exact = workspace:FindFirstChild(name, true)
    if exact and exact:IsA("BasePart") then
        return exact
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower() == wanted then
            return obj
        end
    end
    return nil
end

