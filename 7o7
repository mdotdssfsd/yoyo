---------------------------------------------------------
-- NEW EXPANDING PART HITBOX SYSTEM
---------------------------------------------------------

local function getCharacter(player)
    return player and player.Character
end

local function getRoot(player)
    local character = getCharacter(player)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
    local character = getCharacter(player)
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function isAlive(player)
    local humanoid = getHumanoid(player)
    local root = getRoot(player)

    return humanoid
        and humanoid.Health > 0
        and root ~= nil
end

local function applyHitboxToPlayer(player)
    if player == LocalPlayer then return end

    if isAlive(player) then
        local root = getRoot(player)
        if root then
            if FeatureState.ShowHitbox then
                local mult = FeatureState.HitboxSize
                root.Size = Vector3.new(2 * mult, 2 * mult, 1 * mult)
                root.Transparency = 0.7
                root.Color = FeatureState.HitboxColor
                root.Material = Enum.Material.SmoothPlastic
                root.CanCollide = false
            else
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
            end
        end
    end
end

local function updateHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        applyHitboxToPlayer(player)
    end
end

---------------------------------------------------------
-- ANIMATION
---------------------------------------------------------

local function setCameraSensitivity()
    -- Roblox does not expose a public writable camera sensitivity property.
end

local function getAnimationMultiplier()
    local multiplier =
        FeatureState.PunchSpeed
        and FeatureState.PunchSpeedValue
        or 1

    if FeatureState.NoAttackDelay then
        multiplier = math.max(multiplier, 2)
    end

    return math.clamp(multiplier, 0.05, 20)
end

local function applyAnimationSpeed(track)
    if not track then
        return
    end

    pcall(function()
        track:AdjustSpeed(getAnimationMultiplier())
    end)
end

local animationConnection

local function connectCharacterRuntime(character)
    if animationConnection then
        animationConnection:Disconnect()
        animationConnection = nil
    end

    local humanoid =
        character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    animationConnection =
        humanoid.AnimationPlayed:Connect(function(track)
            task.defer(function()
                applyAnimationSpeed(track)
            end)
        end)

    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
        applyAnimationSpeed(track)
    end
end

local function updateAnimationSpeeds()
    local humanoid = LocalPlayer and getHumanoid(LocalPlayer)

    if not humanoid then
        return
    end

    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
        applyAnimationSpeed(track)
    end
end

if LocalPlayer then
    LocalPlayer.CharacterAdded:Connect(function(character)
        task.wait(0.2)
        connectCharacterRuntime(character)
    end)

    if LocalPlayer.Character then
        connectCharacterRuntime(LocalPlayer.Character)
    end
end

---------------------------------------------------------
-- KILL AURA TARGETING
---------------------------------------------------------

local function getNearestTarget()
    local myRoot = getRoot(LocalPlayer)

    if not myRoot then
        return nil
    end

    local best
    local bestDistance

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local root = getRoot(player)

            local distance =
                root and
                (root.Position - myRoot.Position).Magnitude

            if distance and distance <= FeatureState.KARange then
                if not bestDistance or distance < bestDistance then
                    best = player
                    bestDistance = distance
                end
            end
        end
    end

    return best
end

local function getLowestHealthTarget()
    local myRoot = getRoot(LocalPlayer)

    if not myRoot then
        return nil
    end

    local best
    local bestHealth
    local bestDistance

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) then
            local root = getRoot(player)
            local humanoid = getHumanoid(player)

            local distance =
                root and
                (root.Position - myRoot.Position).Magnitude

            if distance and distance <= FeatureState.KARange then
                if not bestHealth or humanoid.Health < bestHealth then
                    best = player
                    bestHealth = humanoid.Health
                    bestDistance = distance
                elseif humanoid.Health == bestHealth
                    and distance < bestDistance then

                    best = player
                    bestDistance = distance
                end
            end
        end
    end

    return best
end

local currentTarget = nil

local function updateKillAuraTarget()
    if not FeatureState.KillAura then
        currentTarget = nil
        return
    end

    if FeatureState.KALowestHealth then
        currentTarget = getLowestHealthTarget()
    else
        currentTarget = getNearestTarget()
    end
end

---------------------------------------------------------
-- GLIDE
---------------------------------------------------------

local function updateGlide()
    if not FeatureState.WeaveGlide then
        return
    end

    local root = getRoot(LocalPlayer)
    local humanoid = getHumanoid(LocalPlayer)

    if not root
        or not humanoid
        or humanoid.Health <= 0 then

        return
    end

    local move = humanoid.MoveDirection

    if move.Magnitude > 0 then
        local strength =
            math.clamp(
                FeatureState.WeaveGlideStrength,
                1,
                10
            )

        root.AssemblyLinearVelocity = Vector3.new(
            move.X * 16 * strength,
            root.AssemblyLinearVelocity.Y,
            move.Z * 16 * strength
        )
    end
end

local function refreshStatus()
    if not StatusLabel or not StatusLabel.Parent then
        return
    end

    if FeatureState.KillAura and currentTarget then
        StatusLabel.Text = "● TARGET"
    elseif FeatureState.WeaveGlide then
        StatusLabel.Text = "● GLIDE"
    else
        StatusLabel.Text = "● READY"
    end
end

